+static int ps3disk_add_region(struct ps3_storage_device *dev,
+			      struct ps3disk_private *priv, unsigned int idx,
+			      bool writable)
+{
+	struct ps3_storage_region *region = &dev->regions[idx];
+	struct ps3disk_region_priv *rp = &priv->disk[priv->num_disks];
+	struct request_queue *queue;
+	struct gendisk *gendisk;
+	int error;
+
+	rp->dev = dev;
+	rp->region_idx = idx;
+	rp->devidx = priv->devidx_base + idx;
+
+	gendisk = blk_mq_alloc_disk(&priv->tag_set, rp);
+	if (IS_ERR(gendisk)) {
+		dev_err(&dev->sbd.core,
+			"%s:%u: blk_mq_alloc_disk failed for region %u\n",
+			__func__, __LINE__, idx);
+		return PTR_ERR(gendisk);
+	}
+
+	queue = gendisk->queue;
+
+	blk_queue_max_hw_sectors(queue, dev->bounce_size >> 9);
+	blk_queue_dma_alignment(queue, dev->blk_size-1);
+	blk_queue_logical_block_size(queue, dev->blk_size);
+
+	blk_queue_write_cache(queue, true, false);
+
+	blk_queue_max_segments(queue, -1);
+	blk_queue_max_segment_size(queue, dev->bounce_size);
+
+	rp->gendisk = gendisk;
+	gendisk->major = ps3disk_major;
+	gendisk->first_minor = rp->devidx * PS3DISK_MINORS;
+	gendisk->minors = PS3DISK_MINORS;
+	gendisk->fops = &ps3disk_fops;
+	gendisk->private_data = rp;
+	snprintf(gendisk->disk_name, sizeof(gendisk->disk_name), PS3DISK_NAME,
+		 rp->devidx+'a');
+	set_capacity(gendisk, region->size*priv->blocking_factor);
+
+	/* Before device_add_disk(), so the first partition scan sees it */
+	set_disk_ro(gendisk, !writable);
+
+	dev_info(&dev->sbd.core,
+		 "%s: region %u id %u start %llu size %llu (%llu MiB) %s\n",
+		 gendisk->disk_name, idx, region->id, region->start,
+		 region->size, get_capacity(gendisk) >> 11,
+		 writable ? "read-write" : "read-only");
+
+	error = device_add_disk(&dev->sbd.core, gendisk, NULL);
+	if (error) {
+		put_disk(gendisk);
+		return error;
+	}
+
+	priv->num_disks++;
+	return 0;
+}
+
+static void ps3disk_del_disks(struct ps3disk_private *priv)
+{
+	unsigned int i;
+
+	/*
+	 * Delete every disk before releasing any of them, so no region queue
+	 * is left able to submit while another is being torn down.
+	 */
+	for (i = 0; i < priv->num_disks; i++)
+		del_gendisk(priv->disk[i].gendisk);
+	for (i = 0; i < priv->num_disks; i++)
+		put_disk(priv->disk[i].gendisk);
+	priv->num_disks = 0;
+}
