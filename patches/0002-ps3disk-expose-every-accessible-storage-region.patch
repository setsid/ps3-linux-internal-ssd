+/*
+ * Region 0 of a storage device is the whole physical drive.  Under OtherOS++
+ * it is accessible, and writing to it overwrites the GameOS regions, so it
+ * must never be picked as the region to expose read-write by default.
+ *
+ * ATA IDENTIFY gives the authoritative size.  If it failed, fall back to the
+ * LV1 convention that region id 0 addresses the whole device.
+ */
+static bool ps3disk_region_is_whole_drive(struct ps3_storage_device *dev,
+					  struct ps3disk_private *priv,
+					  unsigned int idx)
+{
+	if (!dev->regions[idx].id)
+		return true;
+
+	return priv->raw_capacity &&
+	       dev->regions[idx].size * priv->blocking_factor >=
+	       priv->raw_capacity;
+}
+
+/*
+ * OtherOS++ creates the OtherOS region last, so it has the highest index of
+ * the regions the hypervisor lets us reach.  Region 0 and anything that spans
+ * the whole drive are skipped: getting this wrong in the permissive direction
+ * exposes the GameOS regions read-write, which costs a GameOS reinstall,
+ * while getting it wrong in the restrictive direction costs a reboot with a
+ * module parameter.  Returns the region index, or -1 if no region looks like
+ * an OtherOS region, in which case nothing is writable by default.
+ */
+static int ps3disk_find_otheros_region(struct ps3_storage_device *dev,
+				       struct ps3disk_private *priv,
+				       unsigned long exposed)
+{
+	unsigned int i;
+	int found = -1;
+
+	for_each_set_bit(i, &exposed, dev->num_regions) {
+		if (!i)
+			continue;	/* Region 0 is the whole drive */
+		if (ps3disk_region_is_whole_drive(dev, priv, i))
+			continue;
+		found = i;
+	}
+
+	return found;
+}
